{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ghost Pricing API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Pricing",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get pricing",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ghost.build/v0/pricing"
          },
          "docs": "Returns current pricing.\n\nThis endpoint is unauthenticated.\n"
        }
      ]
    }
  ],
  "bundled": true
}