{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ghost Health API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Health",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Health check",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ghost.build/v0/health"
          },
          "docs": "Returns 200 OK if the service is healthy."
        }
      ]
    }
  ],
  "bundled": true
}