        {
          "info": {
            "name": "Get database logs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ghost.build/v0/spaces/:space_id/databases/:database_ref/logs",
            "params": [
              {
                "name": "space_id",
                "value": "",
                "type": "path",
                "description": "Ghost space ID."
              },
              {
                "name": "database_ref",
                "value": "",
                "type": "path",
                "description": "Database ID or name."
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Opaque pagination cursor returned as `last_cursor` in a previous\nresponse. When provided, returns the next page of logs older than\nthe cursor position.\n"
              },
              {
                "name": "until",
                "value": "",
                "type": "query",
                "description": "Upper bound timestamp — return logs at or before this time (RFC3339 format, e.g., 2024-01-15T10:00:00Z). Defaults to now."
              },
              {
                "name": "since",
                "value": "",
                "type": "query",
                "description": "Lower bound timestamp — fetch logs after this time (RFC3339 format, e.g., 2024-01-15T09:00:00Z)"
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Full-text search terms to filter log lines. Repeat the parameter\nfor multiple values (e.g. `?search=slow+query&search=ERROR`).\n"
              },
              {
                "name": "severity",
                "value": "",
                "type": "query",
                "description": "Severity levels to filter results. Repeat the parameter for multiple\nvalues (e.g. `?severity=ERROR&severity=WARNING`). Common values\ninclude `LOG`, `WARNING`, `ERROR`, and `FATAL`; PostgreSQL may also\nemit `DEBUG*`, `INFO`, `NOTICE`, and `PANIC`.\n"
              }
            ]
          },
          "docs": "Fetch logs for a specific database. Returns up to 500 log entries in\nreverse chronological order. Supports cursor-based pagination via the\n`cursor` parameter and the `last_cursor` field in the response.\n"
        },
