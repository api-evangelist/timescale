{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ghost Spaces API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Spaces",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List spaces",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ghost.build/v0/spaces"
          },
          "docs": "Returns Ghost spaces accessible to the authenticated user.\nFor user JWTs, returns all Ghost spaces the user is a member of.\nFor API keys, returns the single space the key is scoped to.\n"
        },
        {
          "info": {
            "name": "Create a space",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.ghost.build/v0/spaces",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new Ghost space. Requires user authentication (JWT).\nAPI keys cannot be used to create spaces.\nWhen no name is provided, the space is named after its owner\n(e.g. \"Jane Doe's space\").\n"
        },
        {
          "info": {
            "name": "Get a space",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ghost.build/v0/spaces/:space_id",
            "params": [
              {
                "name": "space_id",
                "value": "",
                "type": "path",
                "description": "Ghost space ID."
              }
            ]
          },
          "docs": "Returns details about a single space, including the owner and the\ncaller's role. For user JWTs the role and owner are populated; for API\nkeys they are omitted (the members lookup that resolves the owner is not\navailable to API keys).\n"
        },
        {
          "info": {
            "name": "Rename a space",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.ghost.build/v0/spaces/:space_id/rename",
            "params": [
              {
                "name": "space_id",
                "value": "",
                "type": "path",
                "description": "Ghost space ID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Renames a space. Requires user authentication (JWT).\nAPI keys cannot be used to rename spaces.\n"
        },
        {
          "info": {
            "name": "Get space usage",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ghost.build/v0/spaces/:space_id/usage",
            "params": [
              {
                "name": "space_id",
                "value": "",
                "type": "path",
                "description": "Ghost space ID."
              }
            ]
          },
          "docs": "Returns compute usage, storage usage, and billing/cost information for a space."
        },
        {
          "info": {
            "name": "Get space usage (deprecated)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ghost.build/v0/spaces/:space_id/status",
            "params": [
              {
                "name": "space_id",
                "value": "",
                "type": "path",
                "description": "Ghost space ID."
              }
            ]
          },
          "docs": "Deprecated alias for `GET /spaces/{space_id}/usage`. Use the `/usage` endpoint instead."
        },
        {
          "info": {
            "name": "List space members",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ghost.build/v0/spaces/:space_id/members",
            "params": [
              {
                "name": "space_id",
                "value": "",
                "type": "path",
                "description": "Ghost space ID."
              }
            ]
          },
          "docs": "Lists the members of a space.\nRequires user authentication (JWT). API keys cannot manage members.\n"
        },
        {
          "info": {
            "name": "Remove a member",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.ghost.build/v0/spaces/:space_id/members/:user_id",
            "params": [
              {
                "name": "space_id",
                "value": "",
                "type": "path",
                "description": "Ghost space ID."
              },
              {
                "name": "user_id",
                "value": "",
                "type": "path",
                "description": "User ID of the space member."
              }
            ]
          },
          "docs": "Removes a member from a space. The space owner cannot be removed,\nand callers cannot remove themselves.\nRequires user authentication (JWT). API keys cannot manage members.\n"
        },
        {
          "info": {
            "name": "Update a member's role",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.ghost.build/v0/spaces/:space_id/members/:user_id/role",
            "params": [
              {
                "name": "space_id",
                "value": "",
                "type": "path",
                "description": "Ghost space ID."
              },
              {
                "name": "user_id",
                "value": "",
                "type": "path",
                "description": "User ID of the space member."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Changes a member's role within a space. The `owner` role cannot be\ngranted, the owner's role cannot be changed, and callers cannot\nchange their own role.\nRequires user authentication (JWT). API keys cannot manage members.\n"
        },
        {
          "info": {
            "name": "Leave a space",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.ghost.build/v0/spaces/:space_id/leave",
            "params": [
              {
                "name": "space_id",
                "value": "",
                "type": "path",
                "description": "Ghost space ID."
              }
            ]
          },
          "docs": "Removes the authenticated user from the space. Requires user\nauthentication (JWT). API keys cannot leave a space. The space owner\ncannot leave their own space.\n"
        },
        {
          "info": {
            "name": "List sent invites",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ghost.build/v0/spaces/:space_id/invites",
            "params": [
              {
                "name": "space_id",
                "value": "",
                "type": "path",
                "description": "Ghost space ID."
              }
            ]
          },
          "docs": "Lists the pending invites that have been sent for a space.\nRequires user authentication (JWT). API keys cannot manage invites.\n"
        },
        {
          "info": {
            "name": "Invite a user to a space",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.ghost.build/v0/spaces/:space_id/invites",
            "params": [
              {
                "name": "space_id",
                "value": "",
                "type": "path",
                "description": "Ghost space ID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Invites a user to a space by email address. The invitee accepts the\ninvitation with their own Ghost account.\nRequires user authentication (JWT). API keys cannot manage invites.\n"
        },
        {
          "info": {
            "name": "Cancel a sent invite",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.ghost.build/v0/spaces/:space_id/invites/:email",
            "params": [
              {
                "name": "space_id",
                "value": "",
                "type": "path",
                "description": "Ghost space ID."
              },
              {
                "name": "email",
                "value": "",
                "type": "path",
                "description": "Email address the invite was sent to."
              }
            ]
          },
          "docs": "Cancels the pending invite sent to the given email address for a space.\nRequires user authentication (JWT). API keys cannot manage invites.\n"
        },
