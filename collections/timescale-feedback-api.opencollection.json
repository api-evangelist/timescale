{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ghost Feedback API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Feedback",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Submit feedback",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.ghost.build/v0/feedback",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Submits feedback or bug report."
        }
      ]
    }
  ],
  "bundled": true
}